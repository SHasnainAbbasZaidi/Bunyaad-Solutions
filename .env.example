# Copy to .env. Never commit .env or production data.
DATABASE_URL="file:./dev.db"
# Generate a long random secret: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Initial administrator / host-assisted recovery. No default account or password.
ADMIN_EMAIL=""
ADMIN_NAME="Administrator"
ADMIN_PASSWORD=""
# Persist this directory alongside the SQLite database.
MEDIA_ROOT="storage/uploads"
# Enable only behind a trusted proxy which REPLACES X-Forwarded-For.
TRUST_PROXY="false"
