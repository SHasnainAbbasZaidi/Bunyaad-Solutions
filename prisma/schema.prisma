// Bunyaad Solutions — Database Schema
// Using SQLite for development, easily switchable to PostgreSQL for production

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Authentication & Users ───────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("EDITOR") // SUPER_ADMIN | EDITOR
  active       Boolean  @default(true)
  sessionVersion Int    @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  articles         Article[]
  activityLogs     ActivityLog[]
  contentRevisions ContentRevision[]
  assignedInquiries ContactInquiry[] @relation("AssignedInquiries")
  uploadedMedia    Media[]

  @@map("users")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  @@map("sessions")
}

// ─── Hero Section ─────────────────────────────────────────────────────────────

model HeroSection {
  id              String   @id @default(cuid())
  headline        String   @default("Building the Foundation of Digital Innovation.")
  subtitle        String   @default("")
  description     String   @default("We design, develop, and power digital platforms that connect businesses, empower consumers, and transform industries.")
  ctaPrimaryText  String   @default("Explore Our Solutions")
  ctaPrimaryUrl   String   @default("/solutions")
  ctaSecondaryText String  @default("Contact Us")
  ctaSecondaryUrl String   @default("/contact")
  backgroundImage String?
  published       Boolean  @default(true)
  version         Int      @default(1)
  visualSettings  String   @default("center")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("hero_sections")
}

// ─── About Sections ───────────────────────────────────────────────────────────

model AboutSection {
  id        String   @id @default(cuid())
  sectionKey String  @unique // e.g., "overview", "mission", "vision", "values", "story"
  title     String
  content   String   // Rich text HTML
  image     String?
  sortOrder Int      @default(0)
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("about_sections")
}

// ─── Services ─────────────────────────────────────────────────────────────────

model Service {
  id               String   @id @default(cuid())
  title            String
  slug             String   @unique
  icon             String?  // Lucide icon name
  image            String?
  shortDescription String
  fullContent      String   // Rich text HTML
  targetAudience   String?
  capabilities     String?  // JSON array stored as string
  relatedProjectIds String?
  sortOrder        Int      @default(0)
  published        Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("services")
}

// ─── Projects ─────────────────────────────────────────────────────────────────

model Project {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  logo          String?
  coverImage    String?
  description   String   // Short description
  fullContent   String?  // Rich text HTML
  industry      String?
  businessModel String   @default("B2B") // B2B | B2C | D2C | HYBRID
  status        String   @default("CONCEPT") // CONCEPT | PLANNING | IN_DEVELOPMENT | TESTING | COMING_SOON | LIVE | ON_HOLD | ARCHIVED
  externalUrl   String?
  launchDate    DateTime?
  technologies  String?  // JSON array as string
  featured      Boolean  @default(false)
  sortOrder     Int      @default(0)
  published     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  images ProjectImage[]

  @@map("projects")
}

model ProjectImage {
  id        String  @id @default(cuid())
  projectId String
  url       String
  caption   String?
  sortOrder Int     @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_images")
}

// ─── Team Members ─────────────────────────────────────────────────────────────

model TeamMember {
  id           String   @id @default(cuid())
  name         String
  photo        String?
  designation  String
  department   String?
  biography    String?
  skills       String?  // JSON array as string
  linkedin     String?
  twitter      String?
  github       String?
  website      String?
  isFounder    Boolean  @default(false)
  isLeadership Boolean  @default(false)
  sortOrder    Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("team_members")
}

// ─── Articles / News ──────────────────────────────────────────────────────────

model Article {
  id             String    @id @default(cuid())
  title          String
  slug           String    @unique
  coverImage     String?
  excerpt        String?
  content        String    // Rich text HTML
  category       String    @default("Company Announcements")
  tags           String?   // JSON array as string
  authorId       String
  status         String    @default("DRAFT") // DRAFT | PUBLISHED | ARCHIVED
  featured       Boolean   @default(false)
  seoTitle       String?
  seoDescription String?
  publishedAt    DateTime?
  scheduledAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  author User @relation(fields: [authorId], references: [id])

  @@map("articles")
}

// ─── Contact Inquiries ────────────────────────────────────────────────────────

model ContactInquiry {
  id            String   @id @default(cuid())
  fullName      String
  email         String
  company       String?
  subject       String
  inquiryType   String   @default("General")
  message       String
  status        String   @default("NEW") // NEW | IN_PROGRESS | REPLIED | CLOSED
  assignedToId  String?
  internalNotes String?
  archived      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  assignedTo User? @relation("AssignedInquiries", fields: [assignedToId], references: [id])

  @@map("contact_inquiries")
}

// ─── Media Library ────────────────────────────────────────────────────────────

model Media {
  id           String   @id @default(cuid())
  filename     String
  originalName String
  mimeType     String
  size         Int
  url          String
  alt          String?
  isProtected  Boolean  @default(false)
  uploadedById String?
  createdAt    DateTime @default(now())

  uploadedBy User? @relation(fields: [uploadedById], references: [id])

  @@map("media")
}

// ─── Site Settings ────────────────────────────────────────────────────────────

model SiteSettings {
  id    String @id @default(cuid())
  key   String @unique
  value String // JSON string for complex values
  group String @default("general") // general | contact | social | seo | navigation | footer

  @@map("site_settings")
}

// ─── Activity Logs ────────────────────────────────────────────────────────────

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String
  action     String   // CREATE | UPDATE | DELETE | PUBLISH | UNPUBLISH | LOGIN | LOGOUT
  entityType String   // HeroSection | About | Service | Project | Article | TeamMember | etc.
  entityId   String?
  details    String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("activity_logs")
}

// ─── Content Revisions ────────────────────────────────────────────────────────

model ContentRevision {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  content    String   // JSON snapshot of the content
  userId     String
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("content_revisions")
}

model PasswordReset {
  id String @id @default(cuid())
  userId String
  tokenHash String @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@map("password_resets")
}

model RateLimit {
  key String @id
  count Int @default(1)
  expiresAt DateTime
  @@map("rate_limits")
}
